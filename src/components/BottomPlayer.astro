---
import { releaseRepository } from '~/lib/content/file-release.repository';
import { collectionRepository } from '~/lib/content/file-collection.repository';

const lancamentos = await releaseRepository.listPorRecencia();
const colecoes = await collectionRepository.list();

interface FaixaPlayer {
  titulo: string;
  lancamento: string;
  url: string | null;
  capa: string | null;
}

const faixas: FaixaPlayer[] = lancamentos.flatMap((lancamento) =>
  lancamento.faixas.map((faixa) => ({
    titulo: faixa.titulo,
    lancamento: lancamento.nome,
    url: faixa.audio?.url ?? null,
    capa: lancamento.capa?.url ?? null,
  })),
);

const fontes = [
  { id: 'lancamentos', nome: 'Lançamentos' },
  ...colecoes.map((c) => ({ id: `colecao:${c.slug}`, nome: c.nome })),
  { id: 'ep', nome: 'EP' },
  { id: 'album', nome: 'Álbum' },
  { id: 'aleatoria', nome: 'Aleatória' },
];

const json = JSON.stringify({
  faixas,
  lancamentos: lancamentos.map((l) => ({
    slug: l.slug,
    nome: l.nome,
    tipo: l.tipo,
    faixas: l.faixas.map((f) => ({ titulo: f.titulo, url: f.audio?.url ?? null })),
  })),
  colecoes: colecoes.map((c) => ({ slug: c.slug, nome: c.nome })),
});
---

<div class="player" data-player data-aberto="false">
  <audio data-player-audio preload="none"></audio>

  <div class="player__barra container">
    <div class="player__atual">
      <button type="button" class="btn btn--ghost player__toggle" data-player-toggle aria-expanded="false">
        <span aria-hidden="true">▴</span>
        <span class="visually-hidden">Abrir ou minimizar o player</span>
      </button>
      <div class="player__info">
        <span class="player__titulo" data-player-titulo>Nenhuma faixa</span>
        <span class="player__origem mono" data-player-origem>Lançamentos</span>
      </div>
    </div>

    <div class="player__controles">
      <button type="button" class="btn btn--ghost" data-player-anterior aria-label="Faixa anterior">⏮</button>
      <button type="button" class="btn player__play" data-player-play aria-label="Tocar">▶</button>
      <button type="button" class="btn btn--ghost" data-player-proxima aria-label="Próxima faixa">⏭</button>
    </div>

    <div class="player__volume">
      <span aria-hidden="true">🔊</span>
      <label class="visually-hidden" for="player-volume">Volume</label>
      <input id="player-volume" type="range" min="0" max="100" value="80" data-player-volume />
    </div>
  </div>

  <div class="player__painel" data-player-painel hidden>
    <div class="container player__painel-conteudo">
      <label class="visually-hidden" for="player-fonte">Fonte de reprodução</label>
      <select id="player-fonte" class="select player__fonte" data-player-fonte>
        {fontes.map((fonte) => <option value={fonte.id}>{fonte.nome}</option>)}
      </select>
      <ol class="player__lista list-void" data-player-lista></ol>
    </div>
  </div>
</div>

{/* JSON gerado por JSON.stringify a partir de dados do acervo — sem HTML */}
<script type="application/json" data-player-dados set:html={json} />

<style>
  .player {
    position: fixed;
    inset: auto 0 0 0;
    z-index: var(--z-player);
    background: color-mix(in srgb, var(--surface) 94%, transparent);
    backdrop-filter: blur(14px);
    border-top: 1px solid var(--line-strong);
    box-shadow: var(--shadow-bar);
  }

  .player__barra {
    height: var(--player-h);
    display: flex;
    align-items: center;
    gap: var(--sp-4);
  }

  .player__atual {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    flex: 1 1 auto;
    min-width: 0;
  }

  .player__toggle {
    flex: 0 0 auto;
    padding-inline: var(--sp-3);
  }

  .player[data-aberto='true'] .player__toggle {
    transform: rotate(180deg);
  }

  .player__info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .player__titulo {
    font-size: var(--fs-sm);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .player__origem {
    color: var(--accent-2);
  }

  .player__controles {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    flex: 0 0 auto;
  }

  .player__play {
    min-width: 48px;
    font-size: var(--fs-base);
  }

  .player__volume {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    flex: 0 0 auto;
  }

  .player__volume input {
    width: 96px;
    accent-color: var(--accent);
  }

  .player__painel {
    border-top: 1px solid var(--line);
    max-height: 40vh;
    overflow-y: auto;
  }

  .player__painel-conteudo {
    padding-block: var(--sp-3);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .player__fonte {
    max-width: 280px;
  }

  .player__lista {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }

  .player__lista li button {
    width: 100%;
    text-align: left;
    min-height: var(--tap-min);
    padding: var(--sp-2) var(--sp-3);
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius);
    cursor: pointer;
    color: var(--text);
  }

  .player__lista li button:hover {
    border-color: var(--line-strong);
    box-shadow: var(--glow-accent);
  }

  .player__lista li button[aria-current='true'] {
    color: var(--accent);
    border-color: var(--accent);
  }

  @media (max-width: 640px) {
    .player__volume {
      display: none;
    }
    .player__origem {
      display: none;
    }
  }
</style>
