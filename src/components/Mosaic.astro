---
import PostCard from '~/components/PostCard.astro';
import type { Post } from '~/lib/content/types';
import type { TamanhoTile } from '~/lib/content/popularity';

interface Props {
  posts: Array<{ post: Post; tamanho: TamanhoTile }>;
}

const { posts } = Astro.props;
---

<div class="mosaico" data-mosaico>
  {
    posts.map(({ post, tamanho }) => (
      <PostCard post={post} tamanho={tamanho} />
    ))
  }
</div>

<style>
  .mosaico {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    grid-auto-rows: 130px;
    grid-auto-flow: dense;
    gap: var(--sp-2);
  }

  @media (min-width: 640px) {
    .mosaico {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: 150px;
    }

    :global(.tile--pequeno) {
      grid-column: span 1;
      grid-row: span 1;
    }

    :global(.tile--medio) {
      grid-column: span 2;
      grid-row: span 2;
    }

    :global(.tile--grande) {
      grid-column: span 2;
      grid-row: span 3;
    }
  }
</style>
