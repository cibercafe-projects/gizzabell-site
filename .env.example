# URL publica do site. Usada no build (canonical, sitemap).
SITE_URL=http://localhost:4321

# Fuso horario do servidor: define as datas exibidas dos posts e da agenda.
TZ=America/Sao_Paulo

# Nao defina PORT nem HOST aqui.
# - Hostinger injeta a porta do container e faz o proxy; um PORT fixo quebra o acesso.
# - Na VPS o bind vem do service systemd (127.0.0.1:4321, atras do Caddy).
#
# O cookie de sessao e opaco e guardado no servidor (data/sessions.json),
# por isso nao existe SESSION_SECRET. A senha da artista vive em
# data/admin.json (fora do git), criada com: npm run admin:create -- --usuario artista
